# Scripts run on Linux (Explorer); keep LF regardless of Windows autocrlf (as in Gemma4_kaggle_repo)
*.sh     text eol=lf
*.slurm  text eol=lf
*.py     text eol=lf
*.tsv    text eol=lf

# Repository documentation and Git rules use stable LF endings
*.md           text eol=lf
*.txt          text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Keep manuscript containers byte-for-byte intact on checkout and commit
*.docx   binary
*.pdf    binary
