# PDF files, except the archived submission and current refined manuscript
*.pdf
!paper/submission_v1/*.pdf
!paper/submission_v3/submission_v3.1.pdf

# Local review outputs, personal tool settings, and Office lock files
/tmp/
/.claude/settings.local.json
~$*

# Slurm logs stay on Explorer: they name task ids. Only the folder itself is in git.
logs/*
!logs/.gitkeep

# Python bytecode, written whenever a script is imported or run
__pycache__/
*.pyc
